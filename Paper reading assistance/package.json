{
  "name": "jiaoxiaoai-paper-reader",
  "version": "1.7.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Local paper reader with OCR, visual analysis and multi-paper comparison",
  "scripts": {
    "start": "node server.mjs",
    "tool": "node scripts/paper.mjs",
    "mcp": "node mcp.mjs",
    "install:skill": "node scripts/install.mjs",
