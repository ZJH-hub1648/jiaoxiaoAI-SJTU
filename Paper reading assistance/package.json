    "test:browser": "node tests/stage3-browser.mjs",
    "test:canvas": "node tests/canvas-ui.mjs",
    "pack": "node build-package.mjs",
    "test:portability": "node tests/portability.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.2.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
